    {
      "name": "EditMod",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('an edit without files leaves both file URLs untouched', (done) => {\r\n    pm.sendRequest(pm.request.url.toString(), (err, res) => {\r\n        if (err) {\r\n            done(err);\r\n            return;\r\n        }\r\n\r\n        const mod = res.json();\r\n\r\n        pm.expect(mod.modFileUrl).to.eql(pm.variables.get('modFileUrlBefore'));\r\n        pm.expect(mod.previewImageUrl).to.eql(pm.variables.get('previewImageUrlBefore'));\r\n        done();\r\n    });\r\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const url = pm.request.url.toString();\r\n\r\npm.sendRequest(url, (err, res) => {\r\n    const mod = res.json();\r\n\r\n    pm.collectionVariables.set('modFileUrlBefore', mod.modFileUrl);\r\n    pm.collectionVariables.set('previewImageUrlBefore', mod.previewImageUrl);\r\n});"
            ]
          }
        }
