      "name": "CreateMod",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('modTitle', `Postman Mod ${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responds with 201', () => {\r\n    pm.response.to.have.status(201);\r\n\r\n    const modId = pm.response.json().modId;\r\n    const location = pm.response.headers.get('Location');\r\n\r\n    pm.expect(location, 'Location header').to.be.a('string');\r\n    pm.expect(location).to.include(modId);\r\n\r\n    pm.collectionVariables.set('modId', modId);\r\n});"
            ]
          }
        }
      ],
