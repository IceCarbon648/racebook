    {
      "name": "GetModDetails",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responds with all mod details', () => {\r\n    const mod = pm.response.json();\r\n    const fields = [\r\n        'creator',\r\n        'title',\r\n        'type',\r\n        'description',\r\n        'uploadDate',\r\n        'editDate',\r\n        'modFileUrl',\r\n        'previewImageUrl'\r\n    ];\r\n\r\n    fields.forEach((field) => {\r\n        pm.expect(mod, field).to.have.property(field);\r\n        pm.expect(mod[field], field).to.not.be.null;\r\n    });\r\n});"
            ]
          }
        }
      ],
